def read_json_screen(state: dict, expression: str) -> dict:
    snapshot = evaluate(state, expression)
    if not isinstance(snapshot, str):
        raise VerifyError(f"screen snapshot was not text: {snapshot!r}")
    return json.loads(snapshot)


def cmd_check_today(_args: list[str]) -> int:
    state = require_state()
    problems = doctor_problems(state)
    directory = evidence_dir(state)
    evaluate(state, 'document.getElementById("tab-today").click(); "today"')
    deadline = time.time() + 8
    screen: dict = {}
    while time.time() < deadline:
        screen = read_json_screen(state, TODAY_SNAPSHOT)
        if screen.get("headline") and screen.get("todayHidden") is False:
            break
        time.sleep(0.25)
    shot = directory / "today.png"
    width, height = capture_window(state, shot)
    png_width, png_height = png_size(shot)
    (directory / "today.dom.json").write_text(
        json.dumps(screen, ensure_ascii=False, indent=2) + "\n"
    )
    text = evaluate(state, "document.body.innerText")
    (directory / "today.dom.txt").write_text(str(text) + "\n")
    recognized = ocr(shot)
    (directory / "today.ocr.txt").write_text(recognized)
    evaluate(state, 'document.getElementById("tab-weight").click(); "opened"')
    weight: dict = {}
    deadline = time.time() + 8
    while time.time() < deadline:
        weight = read_json_screen(state, WEIGHT_SNAPSHOT)
        if weight.get("headline"):
            break
        time.sleep(0.25)
    (directory / "weight.dom.json").write_text(
        json.dumps(weight, ensure_ascii=False, indent=2) + "\n"
    )
    weigh, intake_rows = db_rows(state)
    version = schema_version(state)
    today = local_today()
    intake_date = expected_intake_date(today)
    forgot_hidden = dt.datetime.now().hour < 4
    ocr_flat = " ".join(recognized.split())
    history = screen.get("history") or ""
    checks = [
        ("doctor", not problems, "; ".join(problems)),
        ("title", screen.get("title") == "DietLock", repr(screen.get("title"))),
        ("empty weight column", screen.get("headline") == "Pas encore de pesée.", repr(screen.get("headline"))),
        ("empty weight note", screen.get("subtitle") == "", repr(screen.get("subtitle"))),
        ("empty energy column", screen.get("energyFigure") == "Pas de moyenne sur 7 jours.", repr(screen.get("energyFigure"))),
        ("empty energy note", screen.get("energyNote") == "" and screen.get("energyPill") == "", repr((screen.get("energyNote"), screen.get("energyPill")))),
        ("today tab selected", screen.get("todayTab") == "true", repr(screen.get("todayTab"))),
        ("weight tab label", screen.get("weightTab") == "Poids", repr(screen.get("weightTab"))),
        ("today screen visible", screen.get("todayHidden") is False, repr(screen.get("todayHidden"))),
        ("weight screen hidden", screen.get("weightHidden") is True, repr(screen.get("weightHidden"))),
        ("weigh-in chip is today", screen.get("weighDate") == today and "Aujourd'hui" in (screen.get("weighChip") or ""), repr(screen.get("weighChip"))),
        ("intake chip date", screen.get("intakeDate") == intake_date, repr(screen.get("intakeDate"))),
        ("forgotten mark", screen.get("forgotHidden") is forgot_hidden, repr(screen.get("forgotHidden"))),
        ("fasted checked", screen.get("fasted") is True, repr(screen.get("fasted"))),
        ("no weigh error", screen.get("weighErrorHidden") is True and screen.get("weighError") == "", repr(screen.get("weighError"))),
        ("no intake error", screen.get("intakeErrorHidden") is True, repr(screen.get("intakeErrorHidden"))),
        ("save status hidden", screen.get("savedHidden") is True, repr(screen.get("savedHidden"))),
        ("confirm hidden", screen.get("confirmHidden") is True, repr(screen.get("confirmHidden"))),
        ("empty history", "Ta première journée apparaîtra ici." in history and "Commence par ton poids de ce matin" in history and screen.get("historyRows") == 0, repr(history)),
        ("schema", version == SCHEMA_VERSION, repr(version)),
        ("no weigh-in rows", len(weigh) == 0, repr(weigh)),
        ("no intake rows", len(intake_rows) == 0, repr(intake_rows)),
        ("png size", (png_width, png_height) == (width, height) == WINDOW, f"{png_width}x{png_height} window {width}x{height}"),
        ("ocr empty copy", "Pas encore" in ocr_flat and "Aujourd" in ocr_flat, "missing from OCR"),
        ("ocr empty history", "première journée" in ocr_flat, "missing from OCR"),
        ("ocr weight tab", "Poids" in ocr_flat, "missing from OCR"),
        ("weight screen headline", weight.get("headline") == "Pas encore de courbe.", repr(weight.get("headline"))),
        ("weight screen subtitle", weight.get("subtitle") == "La tendance apparaîtra après 4 pesées à jeun.", repr(weight.get("subtitle"))),
        ("weight screen range", weight.get("range") == "15 derniers jours" and weight.get("count") == "aucune pesée", repr((weight.get("range"), weight.get("count")))),
        ("weight screen chart", "Ta courbe se dessinera ici." in (weight.get("chart") or ""), repr(weight.get("chart"))),
        ("weight tab selected", weight.get("weightTab") == "true" and weight.get("weightHidden") is False and weight.get("todayHidden") is True, repr(weight.get("weightTab"))),
    ]
    failed = [name for name, ok, _detail in checks if not ok]
    lines = ["check-today PASS" if not failed else "check-today FAIL"]
    for name, ok, detail in checks:
        lines.append(f"{'ok' if ok else 'FAIL'} {name}" + ("" if ok else f" ({detail})"))
    lines.append(f"screenshot {shot} {png_width}x{png_height}")
    report = "\n".join(lines) + "\n"
    (directory / "check-today.txt").write_text(report)
    print(report, end="")
    return 1 if failed else 0


def cmd_frontend_test(_args: list[str]) -> int:
    directory = evidence_dir(require_state() if run_id_from_env() else None)
    files = [
        "src/calendar.test.js",
        "src/chart.test.js",
        "src/keys.test.js",
        "src/save.test.js",
        "src/energy.test.js",
    ]
    command = ["node", "--test", *files]
    proc = subprocess.run(command, cwd=REPO, capture_output=True, text=True)
    body = (
        f"$ {' '.join(command)}\n"
        f"exit: {proc.returncode}\n"
        f"--- stdout ---\n{proc.stdout}"
        f"--- stderr ---\n{proc.stderr}"
    )
    path = directory / "frontend-test.txt"
    path.write_text(body)
    sys.stdout.write(body)
    print(f"evidence {path}")
    return proc.returncode


def cmd_cargo_test(args: list[str]) -> int:
    if args[:1] == ["--"]:
        args = args[1:]
    directory = evidence_dir(require_state() if run_id_from_env() else None)
    command = ["cargo", "test", *args]
    proc = subprocess.run(command, cwd=REPO, capture_output=True, text=True)
    body = (
        f"$ {' '.join(command)}\n"
        f"exit: {proc.returncode}\n"
        f"--- stdout ---\n{proc.stdout}"
        f"--- stderr ---\n{proc.stderr}"
    )
    path = directory / "cargo-test.txt"
    path.write_text(body)
    sys.stdout.write(body)
    print(f"evidence {path}")
    return proc.returncode


def cmd_cleanup(_args: list[str]) -> int:
    run_id = run_id_from_env()
    if not run_id:
        print("cleanup: no current run")
        return 0
    instance = INSTANCE_ROOT / run_id
    state_path = instance / "state.json"
    evidence = EVIDENCE_ROOT / run_id
    if state_path.is_file():
        state = json.loads(state_path.read_text())
        evidence = Path(state["evidence_dir"])
        kill_tree(int(state.get("app_pid") or 0))
        for pid in pids_mentioning(state["instance_dir"]):
            kill_tree(pid)
        kill_tree(int(state.get("xvfb_pid") or 0))
        kill_tree(int(state.get("dbus_pid") or 0))
    if instance.exists():
        import shutil

        shutil.rmtree(instance, ignore_errors=True)
    if CURRENT.is_file() and CURRENT.read_text().strip() == run_id:
        CURRENT.unlink()
    if not evidence.is_dir():
        raise VerifyError(f"cleanup removed evidence at {evidence}")
    print(f"cleanup removed instance {instance}")
    print(f"evidence kept {evidence}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
