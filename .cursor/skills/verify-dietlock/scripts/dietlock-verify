  todayHidden: document.getElementById("screen-today").hidden,
  weightHidden: document.getElementById("screen-weight").hidden,
  weighDate: document.getElementById("weigh-chip").dataset.date,
  weighChip: document.getElementById("weigh-chip").innerText,
  intakeDate: document.getElementById("intake-chip").dataset.date,
  intakeChip: document.getElementById("intake-chip").innerText,
  forgotHidden: document.getElementById("forgot").hidden,
  fasted: document.getElementById("fasted").checked,
  weighErrorHidden: document.getElementById("weigh-error").hidden,
  weighError: document.getElementById("weigh-error").textContent,
  intakeErrorHidden: document.getElementById("intake-error").hidden,
